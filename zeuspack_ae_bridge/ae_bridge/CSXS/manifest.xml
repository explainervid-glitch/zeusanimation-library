<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.zeus.zeuspackaebridge" ExtensionBundleVersion="1.0.5"
    ExtensionBundleName="ZeusPack" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.zeus.zeuspackaebridge.panel" Version="1.0.5" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- AEFT = Adobe After Effects.
                 [15.0,99.9] covers After Effects CC 2018 (15.x, CEP 8/9) through
                 2024+. CEP 9 is the oldest runtime we require. -->
            <Host Name="AEFT" Version="[15.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.zeus.zeuspackaebridge.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/host.jsx</ScriptPath>
                    <!-- The preset browser previews .mp4/.png files sitting next
                         to each .ffx, loaded as file:// URLs. CEF blocks those
                         from a file-origin page unless access is granted here —
                         without it the preview box just renders empty. -->
                    <CEFCommandLine>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>ZeusPack</Menu>
                    <Geometry>
                        <!-- The preset browser opens by default, so the panel
                             starts tall enough to show it. It still shrinks
                             itself (resizeContent) if the browser is closed. -->
                        <Size>
                            <Height>420</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>32</Height>
                            <Width>150</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>600</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
